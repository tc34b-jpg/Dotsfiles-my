{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "arch",
        "color": { "1": "blue"},
        "padding": { "top": 2, "right": 2 }
    },
    "display": {
        "separator": " ➜ ",
        "color": { "keys": "blue" }
    },
    "modules": [
        "title",
        { "type": "colors", "symbol": "circle" },
        // --- SEÇÃO SYSTEM ---
        { "type": "custom", "format": "┌────────── {#20}SYSTEM{#} ──────────┐" },
        { "type": "os", "key": "❘  󰣇 OS      " },
        { "type": "kernel", "key": "❘  󰒋 Kernel  " },
        { "type": "uptime", "key": "❘  󱎫 Uptime  " },
        { "type": "packages", "key": "❘  󰏖 Pack    " },

        // --- SEÇÃO SOFTWARE ---
        { "type": "custom", "format": "├────────── {#12}SOFTWARE{#} ─────────┤" },
        { "type": "shell", "key": "❘  󱆃 Shell   " },
        { "type": "terminal", "key": "❘   Term    " },
        { "type": "wm", "key": "❘   WM      " },

        // --- SEÇÃO HARDWARE ---
        { "type": "custom", "format": "├────────── {#12}HARDWARE{#} ─────────┤" },
        { "type": "host", "key": "❘  󰌢 Host    " },
        { "type": "cpu", "key": "❘  󰻠 CPU     ", "temp": true },
        { "type": "gpu", "key": "❘  󰢮 GPU     ", "temp": true },
        { "type": "memory", "key": "❘  󰍛 RAM     " },
        { "type": "disk", "key": "❘  󰋊 Disk    " },
        { "type": "display", "key": "❘  󰍹 Display " },
        { "type": "battery", "key": "❘  󰁹 Battery " },
        { "type": "power", "key": "❘  󱐋 Power   " },

        // --- SEÇÃO NETWORK & EXTRAS ---
        { "type": "custom", "format": "├─────── {#12}NETWORK & EXTRAS{#} ──────┤" },
        { "type": "localip", "key": "❘  󰩟 Local IP" },
        { "type": "host", "key": "❘  󰖩 Host   " },
        { "type": "custom", "format": "└──────────────────────────────┘" }
    ]
}
