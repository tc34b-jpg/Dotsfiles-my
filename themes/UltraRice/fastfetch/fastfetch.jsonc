{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "arch_small",
        "color": { "1": "red" },
        "padding": { "top": 2, "right": 2 }
    },
    "display": {
        "separator": " ➜ ",
        "color": { "keys": "red" }
    },
    "modules": [
        "title",
        { "type": "colors", "symbol": "circle" },
        { "type": "custom", "format": "┌────────── {#1}SYSTEM{#} ──────────┐" },
        { "type": "os",       "key": "❘  󰣇 OS      " },
        { "type": "kernel",   "key": "❘  󰒋 Kernel  " },
        { "type": "uptime",   "key": "❘  󱎫 Uptime  " },
        { "type": "packages", "key": "❘  󰏖 Pack    " },
        { "type": "custom", "format": "├────────── {#1}SOFTWARE{#} ─────────┤" },
        { "type": "shell",    "key": "❘  󱆃 Shell   " },
        { "type": "terminal", "key": "❘   Term    " },
        { "type": "wm",       "key": "❘   WM      " },
        { "type": "custom", "format": "├────────── {#1}HARDWARE{#} ─────────┤" },
        { "type": "host",    "key": "❘  󰌢 Host    " },
        { "type": "cpu",     "key": "❘  󰻠 CPU     ", "temp": true },
        { "type": "gpu",     "key": "❘  󰢮 GPU     ", "temp": true },
        { "type": "memory",  "key": "❘  󰍛 RAM     " },
        { "type": "disk",    "key": "❘  󰋊 Disk    " },
        { "type": "display", "key": "❘  󰍹 Display " },
        { "type": "battery", "key": "❘  󰁹 Battery " },
        { "type": "custom", "format": "└──────────────────────────────┘" }
    ]
}
